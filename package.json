{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "node .output/server/index.mjs",
    "docker:prod": "docker-compose -f environment/prod/docker-compose.yaml",
    "docker:local": "docker-compose -f environment/docker-compose.yaml",
    "docker:build": "npm run docker:$ENV -- build",
    "docker:clean": "npm run docker:$ENV -- down --rmi all",
    "docker:exec": "npm run docker:$ENV -- exec",
    "docker:run": "npm run docker:$ENV -- run",
    "docker:stop": "npm run docker:$ENV -- stop",
    "docker:up": "npm run docker:$ENV -- up --remove-orphans",
    "docker:rm": "npm run docker:$ENV -- rm",
    "lint": "eslint .",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
  },
  "dependencies": {
    "@hypernym/nuxt-gsap": "^2.4.2",
    "@mdi/font": "^7.4.47",
    "@nuxt/devtools": "latest",
    "@nuxtjs/google-fonts": "^3.1.0",
    "nuxt": "^3.8.1",
    "nuxt-gsap-module": "^2.0.0",
    "nuxt-viewport": "^2.1.5",
    "sass": "^1.69.5",
    "vite-plugin-vuetify": "^1.0.2",
    "vue": "^3.4.27",
    "vue-lottie-player": "^0.1.9",
    "vue-router": "^4.2.5",
    "vuetify": "^3.4.2",
    "@lordicon/element": "^1.4.2",
    "@nuxt/kit": "^3.12.4",
    "boxicons": "^2.1.4",
    "gsap": "^3.12.2",
    "lottie-web": "^5.12.2",
    "vee-validate": "^4.11.8",
    "vue3-lottie": "^3.3.0"
  },
  "engines": {
    "node": "20.16.0"
  },
  "lint-staged": {
    "**/*.{js, jsx, ts, tsx, vue}": [
      "npm run lint --fix"
    ]
  }
}
